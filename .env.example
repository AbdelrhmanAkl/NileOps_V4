# ==============================================================================
# NileOps — Intelligent Digital Banking Operations Platform
# Environment Configuration Template (.env.example)
#
# IMPORTANT: Copy this file to .env for local development. Never commit .env.
# This template contains only non-secret placeholders and safe development defaults.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="NileOps Digital Banking Operations"
API_V1_PREFIX="/api/v1"

# Security & Authentication
SECRET_KEY=change-this-insecure-key-to-a-secure-256-bit-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nileops_app
POSTGRES_PASSWORD=nileops_dev_pass
POSTGRES_DB=nileops_db
DATABASE_URL=postgresql+asyncpg://nileops_app:nileops_dev_pass@localhost:5432/nileops_db

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=nileops_kb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=dynamic  # Probed automatically at model startup (no fixed dimension assumed)

# AI / Ollama Inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Document Upload & Storage
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB
