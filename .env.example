# ==============================================================================
# NileOps — Intelligent Digital Banking Operations Platform
# Environment Configuration Template (.env.example)
#
# IMPORTANT: Copy this file to .env for local development. Never commit .env.
# This template contains safe development defaults for Native Windows Execution.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="NileOps Digital Banking Operations"
API_V1_PREFIX="/api/v1"

# Security & Authentication
SECRET_KEY=change-this-insecure-key-to-a-secure-256-bit-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# PostgreSQL 16 (Standard NileOps Database via Docker / Native):
DATABASE_URL=postgresql+asyncpg://nileops_app:NileOps_App_2026_Secure_Db@127.0.0.1:5432/nileops

# Document Upload & Storage
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB

# Vector Store & AI Services
QDRANT_URL=http://127.0.0.1:6333
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
