# NileOps — Hardened Git Ignore

# Environments and Secrets
.env
.env.local
.env.*.local
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Quality
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
reports/

# Frontend & Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Document Uploads & Storage (Strictly synthetic; isolated storage)
backend/uploads/*
!backend/uploads/.gitkeep

# Machine Learning & Large Artifacts
models/
*.onnx
*.bin
*.safetensors
*.pt
*.pth

# Database & Container Data
postgres_data/
qdrant_data/
*.sqlite3
*.db

# OS & Editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Privacy Boundary Protection (Never commit uploaded physical ID images or raw scans)
.user_uploaded/
*.log
